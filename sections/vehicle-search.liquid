{%- comment -%}
  Vehicle search — four cascading selects (Make > Model > Body > Year).

  Reads data from the app proxy exposed by the "Vehicles data transformer" app:

    /apps/vehicle-search/vehicles.json              -> Make list (~1 KB)
    /apps/vehicle-search/vehicles.json?make=toyota  -> that Make's tree (~21 KB)

  The data is NOT in the theme's assets/ folder. Shopify gates theme file writes
  behind a write_themes exemption, so the app serves the JSON from the shop's own
  domain instead. Same-origin, so no CORS.

  Copy this file to your theme's sections/ directory, then add "Vehicle search"
  to any template from the theme editor.
{%- endcomment -%}

<div
  class="vehicle-search"
  id="vehicle-search-{{ section.id }}"
  data-endpoint="{{ section.settings.endpoint }}"
  data-collections-url="{{ routes.collections_url }}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="vehicle-search__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="vehicle-search__status" data-role="status" role="status" aria-live="polite"></div>

  <div class="vehicle-search__grid">
    <div class="vehicle-search__field">
      <label for="vs-make-{{ section.id }}">Make</label>
      <select id="vs-make-{{ section.id }}" data-role="make" disabled>
        <option value="">Loading…</option>
      </select>
    </div>

    <div class="vehicle-search__field">
      <label for="vs-model-{{ section.id }}">Model</label>
      <select id="vs-model-{{ section.id }}" data-role="model" disabled>
        <option value="">Select a make first</option>
      </select>
    </div>

    <div class="vehicle-search__field">
      <label for="vs-body-{{ section.id }}">Body</label>
      <select id="vs-body-{{ section.id }}" data-role="body" disabled>
        <option value="">Select a model first</option>
      </select>
    </div>

    <div class="vehicle-search__field">
      <label for="vs-year-{{ section.id }}">Year</label>
      <select id="vs-year-{{ section.id }}" data-role="year" disabled>
        <option value="">Select a body first</option>
      </select>
    </div>
  </div>

  <div class="vehicle-search__actions">
    <button type="button" class="vehicle-search__submit" data-role="find" disabled>
      {{- section.settings.button_label | default: 'Find parts' -}}
    </button>
  </div>

  <div class="vehicle-search__result" data-role="result" hidden></div>
</div>

{%- style -%}
  #vehicle-search-{{ section.id }} {
    max-width: 1100px;
    margin: 0 auto;
    padding: {{ section.settings.padding_block }}px 1.5rem;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__heading {
    margin: 0 0 1rem;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__field label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__field select {
    width: 100%;
    padding: 0.65rem 0.75rem;
    border: 1px solid rgba(0, 0, 0, 0.25);
    border-radius: 6px;
    background: #fff;
    font-size: 0.95rem;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__field select:disabled {
    background: rgba(0, 0, 0, 0.04);
    color: rgba(0, 0, 0, 0.45);
    cursor: not-allowed;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__status {
    min-height: 1.25rem;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__status[data-tone="error"] {
    color: #b3261e;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__actions {
    margin-top: 1rem;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__submit {
    padding: 0.7rem 1.5rem;
    border: 1px solid transparent;
    border-radius: 6px;
    background: #111;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__submit:disabled {
    background: rgba(0, 0, 0, 0.08);
    color: rgba(0, 0, 0, 0.45);
    cursor: not-allowed;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__result {
    margin-top: 1.5rem;
    padding: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 8px;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__result dl {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: rgba(0, 0, 0, 0.65);
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.getElementById('vehicle-search-{{ section.id }}');
    if (!root) return;

    var ENDPOINT = root.dataset.endpoint || '/apps/vehicle-search/vehicles.json';
    // routes.collections_url, so the link keeps any locale/market prefix.
    var COLLECTIONS_URL = root.dataset.collectionsUrl || '/collections';

    var makeEl = root.querySelector('[data-role="make"]');
    var modelEl = root.querySelector('[data-role="model"]');
    var bodyEl = root.querySelector('[data-role="body"]');
    var yearEl = root.querySelector('[data-role="year"]');
    var statusEl = root.querySelector('[data-role="status"]');
    var resultEl = root.querySelector('[data-role="result"]');
    var findEl = root.querySelector('[data-role="find"]');

    // slug -> { name, models: { model: [bodies] } }, from the index. Covers the
    // Model and Body selects with no network request.
    var skeleton = {};

    // slug -> full Model>Body>Year tree. Needed only for years and leaf data.
    var cache = {};

    // One entry per Year option, in option order: { year: '1979-1988', vehicle: {…} }.
    // A year range can hold several series, and each gets its own option, so the
    // option value is an index into this array rather than the year string — no
    // delimiter to escape, and no ambiguity when two options share a year.
    var yearChoices = [];
    // slug -> in-flight request, so a background prefetch and a later click on
    // the same Make share one request instead of racing.
    var pending = {};

    /**
     * Fetches a Make's full tree, or returns the cached/in-flight one.
     *
     * Called speculatively the moment a Make is selected. By the time the user
     * has picked a Model and a Body — two interactions later — this has almost
     * always landed, so the Year select fills instantly.
     */
    function loadTree(slug) {
      if (cache[slug]) return Promise.resolve(cache[slug]);
      if (pending[slug]) return pending[slug];

      pending[slug] = getJson(ENDPOINT + '?make=' + encodeURIComponent(slug))
        .then(function (data) {
          cache[slug] = data;
          delete pending[slug];
          return data;
        })
        .catch(function (error) {
          delete pending[slug];
          throw error;
        });

      return pending[slug];
    }

    function status(message, tone) {
      statusEl.textContent = message || '';
      if (tone) statusEl.setAttribute('data-tone', tone);
      else statusEl.removeAttribute('data-tone');
    }

    function fill(select, options, placeholder) {
      select.innerHTML = '';
      var first = document.createElement('option');
      first.value = '';
      first.textContent = placeholder;
      select.appendChild(first);

      options.forEach(function (option) {
        var el = document.createElement('option');
        el.value = option.value;
        el.textContent = option.label;
        select.appendChild(el);
      });

      select.disabled = options.length === 0;
    }

    function reset(select, placeholder) {
      select.innerHTML = '<option value="">' + placeholder + '</option>';
      select.disabled = true;
    }

    /**
     * Resets the Year select and drops the choice list with it. Kept together so a
     * stale index can never resolve against a rebuilt list.
     */
    function resetYear(placeholder) {
      yearChoices = [];
      reset(yearEl, placeholder);
    }

    function hideResult() {
      resultEl.hidden = true;
      resultEl.innerHTML = '';
    }

    /**
     * Three things arrive where we expect JSON, each needing a different fix:
     *
     *   - an EMPTY body with a 404. **`shopify theme dev` does not forward
     *     app-proxy paths.** Its local server proxies ordinary storefront requests
     *     to the shop but answers `/apps/*` itself with a zero-length 404, so the
     *     request never reaches the app. Verified 2026-07-31: `/` returns the theme,
     *     `/apps/vehicle-search/vehicles.json` returns 404 + Content-Length 0, while
     *     the same path on the shop domain resolves. Test anything that touches the
     *     proxy on a real preview URL, not localhost.
     *   - a 302 to /password, when the storefront is password protected.
     *   - the app's own 404 page, when [app_proxy].url has a wrong path
     *     (it must be exactly <app base URL>/proxy) or points at a dead dev tunnel.
     *
     * Read the body as text and inspect it before parsing, so none of these
     * surface as "Unexpected end of JSON input" or "Unexpected token '<'" — those
     * name the symptom and hide the cause.
     */
    function getJson(url) {
      return fetch(url, { headers: { Accept: 'application/json' } }).then(function (response) {
        return response.text().then(function (raw) {
          var type = response.headers.get('content-type') || '';
          var context = ' (HTTP ' + response.status + ', ' + (type || 'no content type') + ')';

          if (response.redirected && response.url.indexOf('/password') !== -1) {
            throw new Error(
              'The storefront is password protected, so the request was redirected to ' +
                'the password page. Turn off Online Store > Preferences > Restrict access.'
            );
          }

          if (raw === '') {
            var isLocal = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
            throw new Error(
              'Empty response from ' +
                url +
                context +
                '. The request never reached the app. ' +
                (isLocal
                  ? 'This page is on ' +
                    location.hostname +
                    ', and the local theme dev server does not forward app-proxy ' +
                    'paths — it answers /apps/* itself with an empty 404. Open the ' +
                    'preview URL on the shop domain instead.'
                  : 'Check that [app_proxy].url in shopify.app.toml points at your ' +
                    'current app URL + "/proxy" — a dev tunnel URL changes every time ' +
                    'shopify app dev restarts — then run: shopify app deploy')
            );
          }

          if (type.indexOf('application/json') === -1) {
            throw new Error(
              'Expected JSON from ' +
                url +
                context +
                '. ' +
                (response.status === 404
                  ? 'The app proxy resolved to a route that does not exist. Check that ' +
                    '[app_proxy].url is your app URL + "/proxy" with no extra path ' +
                    'segments, then run: shopify app deploy'
                  : 'Is the app running, and has a dataset been published?')
            );
          }

          var body;
          try {
            body = JSON.parse(raw);
          } catch (error) {
            throw new Error('Malformed JSON from ' + url + context + ': ' + raw.slice(0, 120));
          }

          if (!response.ok) {
            throw new Error(body && body.message ? body.message : 'Request failed' + context);
          }

          return body;
        });
      });
    }

    function loadMakes() {
      status('Loading vehicles…');
      getJson(ENDPOINT)
        .then(function (index) {
          var makes = (index && index.makes) || [];
          if (!makes.length) {
            status('No vehicle data has been published yet.', 'error');
            reset(makeEl, 'No data');
            return;
          }
          makes.forEach(function (make) {
            skeleton[make.slug] = make;
          });

          fill(
            makeEl,
            makes.map(function (make) {
              // value is the slug — that is what ?make= expects.
              return { value: make.slug, label: make.name };
            }),
            'Select make'
          );
          status(
            index.vehicleCount
              ? index.vehicleCount.toLocaleString() + ' vehicles across ' + makes.length + ' makes'
              : ''
          );
        })
        .catch(function (error) {
          status(error.message, 'error');
          reset(makeEl, 'Unavailable');
        });
    }

    makeEl.addEventListener('change', function () {
      var slug = makeEl.value;
      reset(bodyEl, 'Select a model first');
      resetYear('Select a body first');
      hideResult();
      refreshFind();

      if (!slug || !skeleton[slug]) {
        reset(modelEl, 'Select a make first');
        return;
      }

      // Instant — model names came down with the index.
      fill(
        modelEl,
        Object.keys(skeleton[slug].models).map(function (model) {
          return { value: model, label: model };
        }),
        'Select model'
      );

      // Warm the full tree now, while the user is reading the Model list.
      status('');
      loadTree(slug).catch(function () {
        /* Surfaced on Body change, where it actually blocks the user. */
      });
    });

    modelEl.addEventListener('change', function () {
      resetYear('Select a body first');
      hideResult();
      refreshFind();

      var slug = makeEl.value;
      if (!modelEl.value || !skeleton[slug]) {
        reset(bodyEl, 'Select a model first');
        return;
      }

      // Instant — body names also came down with the index.
      fill(
        bodyEl,
        (skeleton[slug].models[modelEl.value] || []).map(function (body) {
          return { value: body, label: body };
        }),
        'Select body'
      );
    });

    bodyEl.addEventListener('change', function () {
      hideResult();

      var slug = makeEl.value;
      var model = modelEl.value;
      var body = bodyEl.value;

      if (!body) {
        resetYear('Select a body first');
        return;
      }

      // First point that needs year data. Usually already cached by the prefetch.
      resetYear(cache[slug] ? 'Select year' : 'Loading…');

      loadTree(slug)
        .then(function (tree) {
          // The user may have changed an earlier select while this was in flight.
          if (makeEl.value !== slug || modelEl.value !== model || bodyEl.value !== body) return;

          var branch = tree[model] && tree[model][body];
          if (!branch) {
            resetYear('No years found');
            return;
          }

          // Year values are never plain numbers — the export gives a start and an
          // end, published as "2015-2019" or "2018-Current". Sort on the first
          // 4-digit year found so ranges order sensibly, then fall back to a string
          // compare so that, for a shared start year, "2018-Current" outranks
          // "2018-2024".
          var years = Object.keys(branch).sort(function (a, b) {
            var diff = leadingYear(b) - leadingYear(a);
            return diff !== 0 ? diff : String(b).localeCompare(String(a));
          });

          // One option per vehicle, not per year range: where series overlap, the
          // series in the label is the only thing telling the two apart, so
          // "1979-1988 (XD-XF)" and "1979-1988 (XD-XH)" are separate choices. The
          // series is omitted when the export has none — about two thirds of rows.
          yearChoices = [];
          years.forEach(function (year) {
            (branch[year] || []).forEach(function (vehicle) {
              yearChoices.push({ year: year, vehicle: vehicle });
            });
          });

          fill(
            yearEl,
            yearChoices.map(function (choice, index) {
              return {
                value: String(index),
                label: choice.year + (choice.vehicle.variant ? ' (' + choice.vehicle.variant + ')' : ''),
              };
            }),
            'Select year'
          );
        })
        .catch(function (error) {
          if (makeEl.value !== slug || bodyEl.value !== body) return;
          status(error.message, 'error');
          resetYear('Unavailable');
        });
    });

    yearEl.addEventListener('change', function () {
      hideResult();

      // The option value is an index into yearChoices, so the selection already
      // identifies one vehicle even where several share the year range.
      var choice = yearEl.value === '' ? null : yearChoices[Number(yearEl.value)];
      if (!choice) return;

      var vehicle = choice.vehicle;
      var parts = [];
      parts.push('<div>');
      parts.push('<strong>' + escapeHtml(vehicle.name) + '</strong>');
      parts.push('<dl>');
      parts.push('<div>Years: ' + escapeHtml(choice.year) + '</div>');
      if (vehicle.variant) {
        parts.push('<div>Series: ' + escapeHtml(vehicle.variant) + '</div>');
      }
      parts.push('<div>Vehicle ID: ' + escapeHtml(vehicle.id) + '</div>');
      parts.push('</dl>');
      parts.push('</div>');

      resultEl.innerHTML = parts.join('');
      resultEl.hidden = false;

      root.dispatchEvent(
        new CustomEvent('vehicle-search:selected', {
          bubbles: true,
          detail: {
            make: makeEl.options[makeEl.selectedIndex].textContent,
            makeSlug: makeEl.value,
            model: modelEl.value,
            body: bodyEl.value,
            // The year range on its own, without the series suffix the option
            // label carries — that is in `series`.
            year: choice.year,
            series: vehicle.variant || '',
            vehicle: vehicle,
          },
        })
      );
    });

    /**
     * Mirrors how Shopify derives a handle from a title: strip accents,
     * lowercase, and collapse every run of non-alphanumerics into one hyphen.
     * "Corolla" -> "corolla", "3 Series" -> "3-series", "C-Class" -> "c-class".
     */
    function slugify(value) {
      return String(value == null ? '' : value)
        .normalize('NFD')
        .replace(/[^\x00-\x7f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    /**
     * Make + Model are the whole handle — /collections/toyota-corolla. Body and
     * year narrow the fitment within that collection, so they travel as query
     * params rather than as separate collections.
     *
     * Returns null until both are chosen, which is what gates the button.
     */
    function collectionHandle() {
      if (!makeEl.value || !modelEl.value) return null;
      // makeEl.value is already the proxy's slug; slugify is idempotent on it.
      return slugify(makeEl.value + '-' + modelEl.value);
    }

    function refreshFind() {
      findEl.disabled = !collectionHandle();
    }

    /**
     * Shopify storefront filter params, not params of our own — Shopify applies
     * them server-side, so the collection page renders already narrowed.
     *
     * Both metafields must be enabled as filters in the Search & Discovery app.
     * If they are not, Shopify silently ignores the params and returns the
     * whole collection, which looks like the filter "not working".
     */
    var YEAR_FILTER = 'filter.p.m.custom.vehicle_year_range_simple';
    var BODY_FILTER = 'filter.p.m.custom.vehicle_body';

    findEl.addEventListener('click', function () {
      var handle = collectionHandle();
      if (!handle) return;

      var params = new URLSearchParams();
      if (bodyEl.value) params.set(BODY_FILTER, bodyEl.value);

      var choice = yearEl.value === '' ? null : yearChoices[Number(yearEl.value)];
      if (choice) params.set(YEAR_FILTER, choice.year);

      var query = params.toString();
      window.location.href = COLLECTIONS_URL + '/' + handle + (query ? '?' + query : '');
    });

    /** First 4-digit year in a value, or -1 if there isn't one. */
    function leadingYear(value) {
      var match = String(value).match(/\d{4}/);
      return match ? Number(match[0]) : -1;
    }

    function escapeHtml(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, function (char) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char];
      });
    }

    loadMakes();
  })();
</script>

{% schema %}
{
  "name": "Vehicle search",
  "tag": "section",
  "class": "vehicle-search-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find parts for your vehicle"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Find parts"
    },
    {
      "type": "text",
      "id": "endpoint",
      "label": "Data endpoint",
      "default": "/apps/vehicle-search/vehicles.json",
      "info": "App proxy path. Only change this if you changed the app_proxy subpath in shopify.app.toml."
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [{ "name": "Vehicle search" }]
}
{% endschema %}
