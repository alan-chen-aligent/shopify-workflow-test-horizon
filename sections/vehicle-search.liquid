{%- comment -%}
  Vehicle search — four cascading selects (Make > Model > Body > Year).

  Reads data from the app proxy exposed by the "Vehicles data transformer" app:

    /apps/vehicle-search/vehicles.json              -> Make list (~1 KB)
    /apps/vehicle-search/vehicles.json?make=toyota  -> that Make's tree (~21 KB)

  The data is NOT in the theme's assets/ folder. Shopify gates theme file writes
  behind a write_themes exemption, so the app serves the JSON from the shop's own
  domain instead. Same-origin, so no CORS.

  Both responses are cached in localStorage for the "Cache vehicle data" window,
  24 hours by default — the data only changes when a dataset is published, and a
  cached index makes the Make select fill without a request at all. See
  snippets/vehicle-cache.liquid.

  Copy this file to your theme's sections/ directory, then add "Vehicle search"
  to any template from the theme editor.
{%- endcomment -%}

{% render 'vehicle-storage' %}
{% render 'vehicle-json' %}
{% render 'vehicle-cache' %}

<div
  class="vehicle-search"
  id="vehicle-search-{{ section.id }}"
  data-endpoint="{{ section.settings.endpoint }}"
  data-collections-url="{{ routes.collections_url }}"
  data-cache-hours="{{ section.settings.cache_hours | default: 24 }}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="vehicle-search__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="vehicle-search__status" data-role="status" role="status" aria-live="polite"></div>

  <div class="vehicle-search__grid">
    <div class="vehicle-search__field">
      <label for="vs-make-{{ section.id }}">Make</label>
      <select id="vs-make-{{ section.id }}" data-role="make" disabled>
        <option value="">Loading…</option>
      </select>
    </div>

    <div class="vehicle-search__field">
      <label for="vs-model-{{ section.id }}">Model</label>
      <select id="vs-model-{{ section.id }}" data-role="model" disabled>
        <option value="">Select a make first</option>
      </select>
    </div>

    {%- comment -%}
      Hidden until a model turns out to have more than one body type. A model
      with a single body has nothing to choose, so the field is noise — but the
      value is still selected behind the scenes and still sent as a filter.
    {%- endcomment -%}
    <div class="vehicle-search__field" data-role="body-field" hidden>
      <label for="vs-body-{{ section.id }}">Body</label>
      <select id="vs-body-{{ section.id }}" data-role="body" disabled>
        <option value="">Select a model first</option>
      </select>
    </div>

    <div class="vehicle-search__field">
      <label for="vs-year-{{ section.id }}">Year</label>
      <select id="vs-year-{{ section.id }}" data-role="year" disabled>
        <option value="">Select a body first</option>
      </select>
    </div>
  </div>

  <div class="vehicle-search__actions">
    <button type="button" class="vehicle-search__submit" data-role="find" disabled>
      {{- section.settings.button_label | default: 'Find parts' -}}
    </button>
  </div>

  <div class="vehicle-search__result" data-role="result" hidden></div>
</div>

{%- style -%}
  #vehicle-search-{{ section.id }} {
    max-width: 1100px;
    margin: 0 auto;
    padding: {{ section.settings.padding_block }}px 1.5rem;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__heading {
    margin: 0 0 1rem;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__field label {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__field select {
    width: 100%;
    padding: 0.65rem 0.75rem;
    border: 1px solid rgba(0, 0, 0, 0.25);
    border-radius: 6px;
    background: #fff;
    font-size: 0.95rem;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__field select:disabled {
    background: rgba(0, 0, 0, 0.04);
    color: rgba(0, 0, 0, 0.45);
    cursor: not-allowed;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__status {
    min-height: 1.25rem;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__status[data-tone="error"] {
    color: #b3261e;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__actions {
    margin-top: 1rem;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__submit {
    padding: 0.7rem 1.5rem;
    border: 1px solid transparent;
    border-radius: 6px;
    background: #111;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__submit:disabled {
    background: rgba(0, 0, 0, 0.08);
    color: rgba(0, 0, 0, 0.45);
    cursor: not-allowed;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__result {
    margin-top: 1.5rem;
    padding: 1rem;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 8px;
  }
  #vehicle-search-{{ section.id }} .vehicle-search__result dl {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: rgba(0, 0, 0, 0.65);
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.getElementById('vehicle-search-{{ section.id }}');
    if (!root) return;

    var ENDPOINT = root.dataset.endpoint || '/apps/vehicle-search/vehicles.json';
    // routes.collections_url, so the link keeps any locale/market prefix.
    var COLLECTIONS_URL = root.dataset.collectionsUrl || '/collections';

    // Survives the page, unlike `cache` below — see snippets/vehicle-cache.liquid.
    // The setting is in hours because that is how long a merchant thinks in; 0
    // turns it off.
    //
    // Stubbed rather than assumed: this section works without the cache, so a
    // copy of it that arrives without the snippet should lose the caching and
    // nothing else.
    var persisted = window.YMMCache || {
      ttl: 0,
      read: function () {
        return null;
      },
      write: function () {
        return false;
      },
      prune: function () {},
    };
    persisted.ttl = (Number(root.dataset.cacheHours) || 0) * 3600000;

    // Scopes the persisted trees. The app's own dataset version when it sends
    // one, so publishing a new dataset orphans every cached tree at once rather
    // than letting a fresh index pair with a stale one. Known before the first
    // tree is asked for, because the index always resolves first.
    var dataVersion = '';

    var makeEl = root.querySelector('[data-role="make"]');
    var modelEl = root.querySelector('[data-role="model"]');
    var bodyEl = root.querySelector('[data-role="body"]');
    var bodyFieldEl = root.querySelector('[data-role="body-field"]');
    var yearEl = root.querySelector('[data-role="year"]');
    var statusEl = root.querySelector('[data-role="status"]');
    var resultEl = root.querySelector('[data-role="result"]');
    var findEl = root.querySelector('[data-role="find"]');

    // slug -> { name, models: { model: [bodies] } }, from the index. Covers the
    // Model and Body selects with no network request.
    var skeleton = {};

    // slug -> full Model>Body>Year tree. Needed only for years and leaf data.
    var cache = {};

    // One entry per Year option, in option order: { year: '1979-1988', vehicle: {…} }.
    // A year range can hold several series, and each gets its own option, so the
    // option value is an index into this array rather than the year string — no
    // delimiter to escape, and no ambiguity when two options share a year.
    var yearChoices = [];

    // True once the Year select has reached a final state for the current body
    // — filled, empty because the data has none, or failed. Distinguishes "no
    // years to pick" from "years have not arrived yet".
    var yearsSettled = false;
    // slug -> in-flight request, so a background prefetch and a later click on
    // the same Make share one request instead of racing.
    var pending = {};

    /**
     * Fetches a Make's full tree, or returns the cached/in-flight one.
     *
     * Called speculatively the moment a Make is selected. By the time the user
     * has picked a Model and a Body — two interactions later — this has almost
     * always landed, so the Year select fills instantly.
     *
     * Three layers, cheapest first: this page's memory, then localStorage from
     * an earlier visit, then the app.
     */
    function loadTree(slug) {
      if (cache[slug]) return Promise.resolve(cache[slug]);
      if (pending[slug]) return pending[slug];

      var stored = persisted.read('make:' + slug, dataVersion);
      if (stored) {
        cache[slug] = stored;
        return Promise.resolve(stored);
      }

      pending[slug] = getJson(ENDPOINT + '?make=' + encodeURIComponent(slug))
        .then(function (data) {
          cache[slug] = data;
          persisted.write('make:' + slug, data, dataVersion);
          delete pending[slug];
          return data;
        })
        .catch(function (error) {
          delete pending[slug];
          throw error;
        });

      return pending[slug];
    }

    function status(message, tone) {
      statusEl.textContent = message || '';
      if (tone) statusEl.setAttribute('data-tone', tone);
      else statusEl.removeAttribute('data-tone');
    }

    function fill(select, options, placeholder) {
      select.innerHTML = '';
      var first = document.createElement('option');
      first.value = '';
      first.textContent = placeholder;
      select.appendChild(first);

      options.forEach(function (option) {
        var el = document.createElement('option');
        el.value = option.value;
        el.textContent = option.label;
        select.appendChild(el);
      });

      select.disabled = options.length === 0;
    }

    function reset(select, placeholder) {
      select.innerHTML = '<option value="">' + placeholder + '</option>';
      select.disabled = true;
    }

    /**
     * Resets the Year select and drops the choice list with it. Kept together so a
     * stale index can never resolve against a rebuilt list.
     */
    function resetYear(placeholder) {
      yearChoices = [];
      // Back to "not settled": an empty yearChoices means the years are still
      // loading far more often than it means there are none, so the Find button
      // must not read it as "nothing to choose".
      yearsSettled = false;
      reset(yearEl, placeholder);
    }

    function hideResult() {
      resultEl.hidden = true;
      resultEl.innerHTML = '';
    }

    // Reads the body as text and inspects it before parsing, so an app-proxy
    // misconfiguration is named rather than reported as "Unexpected end of JSON
    // input". Shared with the header's vehicle search — see
    // snippets/vehicle-json.liquid, rendered above.
    var getJson = window.YMMJson.getJson;

    /**
     * Fills the Make select from the index and hands off to restore(). Reached
     * from a fetch and from a cache hit alike, so a cached index is not a second
     * code path that can drift from the first.
     */
    function applyIndex(index) {
      var makes = (index && index.makes) || [];
      if (!makes.length) {
        status('No vehicle data has been published yet.', 'error');
        reset(makeEl, 'No data');
        return;
      }

      // Established before any tree is requested, so every tree this page stores
      // is scoped to the index it belongs with. 'unversioned' rather than '' when
      // the app sends no version, because an empty scope means "not scoped" and
      // would make the entry outlive the dataset.
      dataVersion = index.version ? String(index.version) : 'unversioned';
      persisted.prune(dataVersion);

      makes.forEach(function (make) {
        skeleton[make.slug] = make;
      });

      fill(
        makeEl,
        makes.map(function (make) {
          // value is the slug — that is what ?make= expects.
          return { value: make.slug, label: make.name };
        }),
        'Select make'
      );
      status(
        index.vehicleCount
          ? index.vehicleCount.toLocaleString() + ' vehicles across ' + makes.length + ' makes'
          : ''
      );

      // Only now is `skeleton` populated, so this is the first point a
      // remembered vehicle can be validated against the real catalogue.
      restore();
    }

    function loadMakes() {
      // The index is small but it is on the critical path — nothing can be
      // chosen until it lands. A hit here fills the Make select in the first
      // paint and prefills a remembered vehicle with no request at all.
      var stored = persisted.read('index');
      if (stored) {
        applyIndex(stored);
        return;
      }

      status('Loading vehicles…');
      getJson(ENDPOINT)
        .then(function (index) {
          // Only a usable index is worth keeping. Caching an empty one would
          // hold "no vehicle data has been published yet" for the whole window,
          // outliving the publish that fixed it.
          if (index && index.makes && index.makes.length) persisted.write('index', index);
          applyIndex(index);
        })
        .catch(function (error) {
          status(error.message, 'error');
          reset(makeEl, 'Unavailable');
        });
    }

    // ── Cascade ────────────────────────────────────────────────────
    // Each step is a named function rather than an inline listener so that
    // restoring a remembered vehicle can replay the same cascade, instead of
    // dispatching synthetic change events and hoping the handlers agree.

    function onMakeChange() {
      var slug = makeEl.value;
      reset(bodyEl, 'Select a model first');
      setBodyFieldVisible(false);
      resetYear('Select a body first');
      hideResult();
      refreshFind();

      if (!slug || !skeleton[slug]) {
        reset(modelEl, 'Select a make first');
        return;
      }

      // Instant — model names came down with the index.
      fill(
        modelEl,
        Object.keys(skeleton[slug].models).map(function (model) {
          return { value: model, label: model };
        }),
        'Select model'
      );

      // Warm the full tree now, while the user is reading the Model list.
      status('');
      loadTree(slug).catch(function () {
        /* Surfaced on Body change, where it actually blocks the user. */
      });
    }

    function setBodyFieldVisible(visible) {
      if (bodyFieldEl) bodyFieldEl.hidden = !visible;
    }

    /**
     * Returns a promise, because a model with exactly one body type resolves
     * that choice itself and runs straight on to loading the years.
     */
    function onModelChange() {
      resetYear('Select a body first');
      hideResult();

      var slug = makeEl.value;
      if (!modelEl.value || !skeleton[slug]) {
        reset(bodyEl, 'Select a model first');
        setBodyFieldVisible(false);
        refreshFind();
        return Promise.resolve();
      }

      // Instant — body names also came down with the index.
      var bodies = skeleton[slug].models[modelEl.value] || [];

      fill(
        bodyEl,
        bodies.map(function (body) {
          return { value: body, label: body };
        }),
        'Select body'
      );

      if (bodies.length === 0) {
        setBodyFieldVisible(false);
        resetYear('No years found');
        yearsSettled = true;
        refreshFind();
        return Promise.resolve();
      }

      // One body is not a choice. Select it silently and keep the field out of
      // the way — the value is still set, so it is still sent as a filter and
      // the URL is never short a body param.
      if (bodies.length === 1) {
        setBodyFieldVisible(false);
        bodyEl.value = bodies[0];
        refreshFind();
        return onBodyChange();
      }

      setBodyFieldVisible(true);
      refreshFind();
      return Promise.resolve();
    }

    /** Returns a promise so a restore can wait for the Year options to exist. */
    function onBodyChange() {
      hideResult();

      var slug = makeEl.value;
      var model = modelEl.value;
      var body = bodyEl.value;

      if (!body) {
        resetYear('Select a body first');
        refreshFind();
        return Promise.resolve();
      }

      // First point that needs year data. Usually already cached by the prefetch.
      resetYear(cache[slug] ? 'Select year' : 'Loading…');
      refreshFind();

      return loadTree(slug)
        .then(function (tree) {
          // The user may have changed an earlier select while this was in flight.
          if (makeEl.value !== slug || modelEl.value !== model || bodyEl.value !== body) return;

          var branch = tree[model] && tree[model][body];
          if (!branch) {
            resetYear('No years found');
            yearsSettled = true;
            refreshFind();
            return;
          }

          // Year values are never plain numbers — the export gives a start and an
          // end, published as "2015-2019" or "2018-Current". Sort on the first
          // 4-digit year found so ranges order sensibly, then fall back to a string
          // compare so that, for a shared start year, "2018-Current" outranks
          // "2018-2024".
          var years = Object.keys(branch).sort(function (a, b) {
            var diff = leadingYear(b) - leadingYear(a);
            return diff !== 0 ? diff : String(b).localeCompare(String(a));
          });

          // One option per vehicle, not per year range: where series overlap, the
          // series in the label is the only thing telling the two apart, so
          // "1979-1988 (XD-XF)" and "1979-1988 (XD-XH)" are separate choices. The
          // series is omitted when the export has none — about two thirds of rows.
          yearChoices = [];
          years.forEach(function (year) {
            (branch[year] || []).forEach(function (vehicle) {
              yearChoices.push({ year: year, vehicle: vehicle });
            });
          });

          fill(
            yearEl,
            yearChoices.map(function (choice, index) {
              return {
                value: String(index),
                label: choice.year + (choice.vehicle.variant ? ' (' + choice.vehicle.variant + ')' : ''),
              };
            }),
            'Select year'
          );

          yearsSettled = true;
          refreshFind();
        })
        .catch(function (error) {
          if (makeEl.value !== slug || bodyEl.value !== body) return;
          status(error.message, 'error');
          resetYear('Unavailable');
          yearsSettled = true;
          refreshFind();
        });
    }

    function onYearChange() {
      hideResult();
      // Before the early return below, so clearing the year re-disables Find.
      refreshFind();

      // The option value is an index into yearChoices, so the selection already
      // identifies one vehicle even where several share the year range.
      var choice = yearEl.value === '' ? null : yearChoices[Number(yearEl.value)];
      if (!choice) return;

      var vehicle = choice.vehicle;
      var parts = [];
      parts.push('<div>');
      parts.push('<strong>' + escapeHtml(vehicle.name) + '</strong>');
      parts.push('<dl>');
      parts.push('<div>Years: ' + escapeHtml(choice.year) + '</div>');
      if (vehicle.variant) {
        parts.push('<div>Series: ' + escapeHtml(vehicle.variant) + '</div>');
      }
      parts.push('<div>Vehicle ID: ' + escapeHtml(vehicle.id) + '</div>');
      parts.push('</dl>');
      parts.push('</div>');

      resultEl.innerHTML = parts.join('');
      resultEl.hidden = false;

      root.dispatchEvent(
        new CustomEvent('vehicle-search:selected', {
          bubbles: true,
          detail: {
            make: makeEl.options[makeEl.selectedIndex].textContent,
            makeSlug: makeEl.value,
            model: modelEl.value,
            body: bodyEl.value,
            // The year range on its own, without the series suffix the option
            // label carries — that is in `series`.
            year: choice.year,
            series: vehicle.variant || '',
            vehicle: vehicle,
          },
        })
      );
    }

    makeEl.addEventListener('change', function () {
      onMakeChange();
      persist();
    });

    modelEl.addEventListener('change', function () {
      onModelChange();
      persist();
    });

    bodyEl.addEventListener('change', function () {
      onBodyChange();
      persist();
    });

    yearEl.addEventListener('change', function () {
      onYearChange();
      persist();
    });

    /**
     * Mirrors how Shopify derives a handle from a title: strip accents,
     * lowercase, and collapse every run of non-alphanumerics into one hyphen.
     * "Corolla" -> "corolla", "3 Series" -> "3-series", "C-Class" -> "c-class".
     */
    function slugify(value) {
      return String(value == null ? '' : value)
        .normalize('NFD')
        .replace(/[^\x00-\x7f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    /**
     * Make + Model are the whole handle — /collections/toyota-corolla. Body and
     * year narrow the fitment within that collection, so they travel as query
     * params rather than as separate collections.
     *
     * Returns null until both are chosen, which is what gates the button.
     */
    function collectionHandle() {
      if (!makeEl.value || !modelEl.value) return null;
      // makeEl.value is already the proxy's slug; slugify is idempotent on it.
      return slugify(makeEl.value + '-' + modelEl.value);
    }

    /**
     * A body is only required when its field is on screen. A hidden field means
     * there was nothing to choose — either a single body, already selected, or
     * none at all.
     */
    function hasRequiredBody() {
      if (!bodyFieldEl || bodyFieldEl.hidden) return true;
      return bodyEl.value !== '';
    }

    /**
     * A year is required whenever there is one to pick. Until the years settle
     * the answer is no, so the button cannot go live during the fetch and then
     * have the requirement appear underneath the shopper.
     */
    function hasRequiredYear() {
      if (!yearsSettled) return false;
      if (!yearChoices.length) return true;
      return yearEl.value !== '';
    }

    function refreshFind() {
      findEl.disabled = !collectionHandle() || !hasRequiredBody() || !hasRequiredYear();
    }

    /**
     * Shopify storefront filter params, not params of our own — Shopify applies
     * them server-side, so the collection page renders already narrowed.
     *
     * Both metafields must be enabled as filters in the Search & Discovery app.
     * If they are not, Shopify silently ignores the params and returns the
     * whole collection, which looks like the filter "not working".
     */
    var YEAR_FILTER = 'filter.p.m.custom.vehicle_year_range_simple';
    var BODY_FILTER = 'filter.p.m.custom.vehicle_body';

    findEl.addEventListener('click', function () {
      var handle = collectionHandle();
      if (!handle) return;

      var params = new URLSearchParams();
      if (bodyEl.value) params.set(BODY_FILTER, bodyEl.value);

      var choice = yearEl.value === '' ? null : yearChoices[Number(yearEl.value)];
      if (choice) params.set(YEAR_FILTER, choice.year);

      var query = params.toString();
      window.location.href = COLLECTIONS_URL + '/' + handle + (query ? '?' + query : '');
    });

    // ── Remembering the vehicle ────────────────────────────────────

    var store = window.YMMVehicle;

    // Replaying a saved vehicle fires the same cascade steps a shopper would,
    // and each of those clears the selects below it. Without this guard the
    // first replayed step would persist a half-empty vehicle over the very
    // record being restored.
    var restoring = false;

    function currentChoice() {
      return yearEl.value === '' ? null : yearChoices[Number(yearEl.value)];
    }

    /** Saves whatever is selected now, including a partial selection. */
    function persist() {
      if (restoring || !store) return;

      var choice = currentChoice();

      store.write({
        handle: collectionHandle() || '',
        makeSlug: makeEl.value,
        make: makeEl.value ? makeEl.options[makeEl.selectedIndex].textContent : '',
        model: modelEl.value,
        body: bodyEl.value,
        year: choice ? choice.year : '',
        series: choice && choice.vehicle.variant ? choice.vehicle.variant : '',
      });
    }

    /**
     * Recovers a make and model from a collection handle, for a vehicle stored
     * by the results page — which knows the handle but not how it was built.
     *
     * Make slugs can themselves contain hyphens ("mercedes-benz"), so a plain
     * split is ambiguous; the longest matching make slug wins.
     */
    function resolveFromHandle(handle) {
      var best = null;

      Object.keys(skeleton).forEach(function (slug) {
        var prefix = slug + '-';
        if (handle.indexOf(prefix) !== 0) return;
        if (best && best.slug.length >= slug.length) return;

        var modelSlug = handle.slice(prefix.length);
        Object.keys(skeleton[slug].models).forEach(function (model) {
          if (slugify(model) === modelSlug) best = { slug: slug, model: model };
        });
      });

      return best;
    }

    /**
     * Prefills from the remembered vehicle. Every step is verified against the
     * options actually present — the catalogue may have changed since the
     * vehicle was saved — and stops at the first value that no longer exists,
     * leaving the shopper with a valid partial selection rather than a wrong one.
     */
    function restore() {
      if (!store) return;

      var saved = store.read();
      if (!saved) return;

      var makeSlug = saved.makeSlug;
      var model = saved.model;

      if ((!makeSlug || !model) && saved.handle) {
        var resolved = resolveFromHandle(saved.handle);
        if (resolved) {
          makeSlug = resolved.slug;
          model = resolved.model;
        }
      }

      if (!makeSlug || !skeleton[makeSlug]) return;

      restoring = true;

      function done() {
        restoring = false;
      }

      makeEl.value = makeSlug;
      if (makeEl.value !== makeSlug) return done();
      onMakeChange();

      if (!model) return done();
      modelEl.value = model;
      if (modelEl.value !== model) return done();

      onModelChange()
        .then(function () {
          // A single-body model has already picked its body and loaded years.
          if (bodyEl.value) return;
          if (!saved.body) return;

          bodyEl.value = saved.body;
          if (bodyEl.value !== saved.body) return;
          return onBodyChange();
        })
        .then(function () {
          // Empty whenever the chain stopped short of loading a body's years.
          if (!saved.year || !yearChoices.length) return;

          // Matched on the year range alone. The series is a label on the year
          // rather than part of the vehicle's identity, so where two choices
          // share a range the first is as good as the other.
          for (var index = 0; index < yearChoices.length; index++) {
            if (yearChoices[index].year === saved.year) {
              yearEl.value = String(index);
              onYearChange();
              return;
            }
          }
        })
        .catch(function () {
          /* Year data unavailable — the make/model/body prefill still stands. */
        })
        .then(done);
    }

    /** First 4-digit year in a value, or -1 if there isn't one. */
    function leadingYear(value) {
      var match = String(value).match(/\d{4}/);
      return match ? Number(match[0]) : -1;
    }

    function escapeHtml(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, function (char) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char];
      });
    }

    loadMakes();
  })();
</script>

