{% comment %}
  YMM Fitment Selector — sections/ymm-fitment.liquid
  Vehicle picker only. On "Find Parts" it navigates to the matching
  collection page, which renders the results (sections/ymm-fitment-results.liquid).
  Styled to match Dawn theme natively using Dawn's CSS variables.
{% endcomment %}

{% render 'ymm-data' %}

<div class="ymm color-{{ section.settings.color_scheme }} gradient">
  <div class="ymm__selector-bar">
    <div class="page-width">
      <p class="ymm__selector-label">{{ section.settings.heading | default: 'Find parts for your vehicle' }}</p>
      <div class="ymm__selector-row">
        <div class="ymm__field">
          <label class="ymm__field-label" for="sYear">Year</label>
          <div class="ymm__select-wrap">
            <select id="sYear" class="ymm__select"><option value="">— Year —</option></select>
          </div>
        </div>
        <div class="ymm__field">
          <label class="ymm__field-label" for="sMake">Make</label>
          <div class="ymm__select-wrap">
            <select id="sMake" class="ymm__select" disabled><option value="">— Make —</option></select>
          </div>
        </div>
        <div class="ymm__field">
          <label class="ymm__field-label" for="sModel">Model</label>
          <div class="ymm__select-wrap">
            <select id="sModel" class="ymm__select" disabled><option value="">— Model —</option></select>
          </div>
        </div>
        <div class="ymm__field">
          <label class="ymm__field-label" for="sBody">Body Type <span class="ymm__field-optional">(optional)</span></label>
          <div class="ymm__select-wrap">
            <select id="sBody" class="ymm__select" disabled><option value="">— Body —</option></select>
          </div>
        </div>
        <div class="ymm__actions">
          <button id="btnFind" class="button button--primary" disabled>{{ section.settings.button_label | default: 'Find Parts' }}</button>
          <button id="btnClear" class="button button--secondary">Clear</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.ymm__selector-bar{border-bottom:0.1rem solid rgba(var(--color-foreground),.08);padding:2rem 0;background-color:rgb(var(--color-background))}
.ymm__selector-label{font-size:1.2rem;font-weight:600;letter-spacing:.1rem;text-transform:uppercase;color:rgba(var(--color-foreground),.5);margin-bottom:1.2rem}
.ymm__selector-row{display:flex;gap:1rem;align-items:flex-end;flex-wrap:wrap}
.ymm__field{display:flex;flex-direction:column;gap:.4rem}
.ymm__field-label{font-size:1.2rem;letter-spacing:.05rem;color:rgba(var(--color-foreground),.5);font-weight:500}
.ymm__field-optional{opacity:.6;font-weight:400;text-transform:none;letter-spacing:0}
.ymm__select-wrap{position:relative;display:flex;align-items:center}
.ymm__select{appearance:none;-webkit-appearance:none;border:.1rem solid rgba(var(--color-foreground),.2);border-radius:var(--inputs-radius,.3rem);background:rgb(var(--color-background));color:rgb(var(--color-foreground));font-family:var(--font-body-family);font-size:1.4rem;padding:1rem 3.5rem 1rem 1.2rem;min-width:13rem;cursor:pointer;transition:border-color .15s}
.ymm__select:focus-visible{outline:.2rem solid rgba(var(--color-foreground),.5);outline-offset:.3rem}
.ymm__select:disabled{opacity:.4;cursor:not-allowed}
.ymm__actions{display:flex;gap:1rem;align-items:flex-end;padding-bottom:.1rem}
@media screen and (max-width:749px){
  .ymm__selector-row{flex-direction:column;align-items:stretch}
  .ymm__select{min-width:100%;width:100%}
  .ymm__actions{flex-direction:row}
}
</style>

<script>
(function(){
  var vd = window.VEHICLE_DATA;
  var st = { year:'', make:'', model:'', body:'' };

  function el(id){ return document.getElementById(id); }

  function esc(s){
    return String(s||'')
      .replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function setOpts(id, opts, enabled){
    var s = el(id);
    var labels = {sYear:'Year',sMake:'Make',sModel:'Model',sBody:'Body Type'};
    var html = '<option value="">— '+(labels[id]||'')+' —</option>';
    opts.forEach(function(o){ html += '<option value="'+esc(o)+'">'+esc(o)+'</option>'; });
    s.innerHTML = html;
    s.disabled = !enabled;
  }

  // "Find Parts" is enabled once Year + Make + Model resolve to a known
  // collection handle. Body is optional and does not gate the button.
  function handleFor(){
    if(!(st.year && st.make && st.model)) return null;
    return vd.collectionHandles[st.make+'_'+st.model] || null;
  }
  function refreshFind(){ el('btnFind').disabled = !handleFor(); }

  // ── Dropdown cascade ──────────────────────────────────────────
  el('sYear').addEventListener('change', function(){
    st.year=this.value; st.make=''; st.model=''; st.body='';
    setOpts('sMake', st.year?(vd.makesByYear[parseInt(st.year)]||[]):[], !!st.year);
    setOpts('sModel',[],false); setOpts('sBody',[],false);
    refreshFind();
  });
  el('sMake').addEventListener('change', function(){
    st.make=this.value; st.model=''; st.body='';
    setOpts('sModel', st.make?(vd.modelsByMake[st.make]||[]):[], !!st.make);
    setOpts('sBody',[],false);
    refreshFind();
  });
  el('sModel').addEventListener('change', function(){
    st.model=this.value; st.body='';
    var bodies=vd.bodiesByMakeModel[st.make+'_'+st.model]||[];
    setOpts('sBody',bodies,bodies.length>0);
    refreshFind();
  });
  el('sBody').addEventListener('change', function(){
    st.body=this.value;
    refreshFind();
  });

  // ── Find Parts → navigate to the collection page ──────────────
  el('btnFind').addEventListener('click', function(){
    var handle = handleFor();
    if(!handle) return;
    var params = new URLSearchParams();
    params.set('year', st.year);
    if(st.body) params.set('body', st.body);
    // Force the YMM results template regardless of the collection's assigned
    // template, so no per-collection admin setup is required.
    params.set('view', 'ymm-fitment');
    window.location.href = '/collections/'+handle+'?'+params.toString();
  });

  el('btnClear').addEventListener('click', function(){
    st={year:'',make:'',model:'',body:''};
    setOpts('sYear',vd.years,true); el('sYear').value='';
    setOpts('sMake',[],false); setOpts('sModel',[],false); setOpts('sBody',[],false);
    el('btnFind').disabled=true;
  });

  // ── Init ───────────────────────────────────────────────────────
  setOpts('sYear',vd.years,true);
  el('sYear').value='';
})();
</script>

{% schema %}
{
  "name": "YMM Fitment Selector",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Selector heading",
      "default": "Find parts for your vehicle"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Find Parts"
    }
  ],
  "presets": [{ "name": "YMM Fitment Selector" }]
}
{% endschema %}
