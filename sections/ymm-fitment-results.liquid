{% comment %}
  YMM Fitment Results — sections/ymm-fitment-results.liquid

  Renders on a vehicle collection page. The collection handle scopes the page
  to one make and model; body and year come in as Shopify's own storefront
  filters, written by the vehicle selector (sections/vehicle-search.liquid):

    /collections/toyota-4runner
      ?filter.p.m.custom.vehicle_year_range_simple=1984-1989
      &filter.p.m.custom.vehicle_body=SUV

  Because those are native filters, `collection.products` is already narrowed
  by Shopify before this template runs — there is no client-side filtering, no
  Storefront API call and no JavaScript here at all. Both filters must be
  enabled in the Search & Discovery app for the params to take effect;
  otherwise Shopify ignores them and the full collection renders.

  Products are grouped by product type and rendered with the theme's own
  product card (blocks/_product-card.liquid), so they match the rest of Horizon.
  Universal accessories are merged into the same groups, trailing the exact
  matches, rather than listed apart.

  Not paginated, deliberately: merging the two sources means a paginated
  collection.products would repeat every universal product on every page.
  Liquid therefore caps collection.products at 50, which a fitment-filtered
  collection is not expected to exceed. A paginate tag would lift the cap but
  reintroduce the duplication.
{% endcomment %}

{% liquid
  # A "collection" setting resolves to the collection object itself.
  assign universal_collection = section.settings.universal_collection

  # Group heading is always an <h2> for document outline; the setting only
  # picks the visual size, via Horizon's .h2–.h6 utility classes.
  assign heading_class = section.settings.heading_size | default: 'h5'
  assign show_count = section.settings.show_group_count
%}

{% capture product_card_size %}
  {% render 'util-product-grid-card-size', section: section %}
{% endcapture %}
{% assign product_card_size = product_card_size | strip %}

{%- liquid
  # Read the applied filter values by param name, so the remembered vehicle
  # records what Shopify actually filtered on rather than what the URL claimed.
  assign year_param = 'filter.p.m.custom.vehicle_year_range_simple'
  assign body_param = 'filter.p.m.custom.vehicle_body'
  assign active_year = ''
  assign active_body = ''

  for filter in collection.filters
    if filter.param_name == year_param
      for value in filter.active_values
        assign active_year = value.value
      endfor
    elsif filter.param_name == body_param
      for value in filter.active_values
        assign active_body = value.value
      endfor
    endif
  endfor
-%}

{% render 'vehicle-storage' %}

{%- comment -%}
  Case 2 of remembering a vehicle: the shopper landed here directly — a shared
  link, a bookmark, a search result — rather than coming through the selector.
  The URL is the truth about which vehicle they are looking at, so it is written
  back to storage for the selector to prefill from on the next page.

  Runs synchronously, while the selector restores only after its app-proxy fetch
  resolves, so this always wins if both sections are on the same page.
{%- endcomment -%}
<script>
  (function () {
    var store = window.YMMVehicle;
    if (!store) return;

    var page = {
      handle: {{ collection.handle | json }},
      title: {{ collection.title | json }},
      year: {{ active_year | json }},
      body: {{ active_body | json }}
    };

    var saved = store.read();

    if (!saved || saved.handle !== page.handle) {
      // A different vehicle — replace outright. makeSlug and model are left
      // unset on purpose: only the selector holds the catalogue needed to split
      // a handle back into a make and a model, so it derives them on restore.
      store.write({
        handle: page.handle,
        title: page.title,
        year: page.year,
        body: page.body
      });
      return;
    }

    // Same vehicle. Year and body are only overwritten when this page actually
    // filtered on them — arriving unfiltered, from a menu link say, should not
    // erase the narrower selection the shopper made earlier.
    var patch = { title: page.title };
    if (page.body) patch.body = page.body;
    if (page.year) patch.year = page.year;
    store.merge(patch);
  })();
</script>

{% style %}
  .ymm-results--{{ section.id }} {
    --product-grid-gap-mobile: {{ section.settings.columns_gap_vertical | at_most: 12 }}px {{ section.settings.columns_gap_horizontal | at_most: 12 }}px;
    --product-grid-gap-desktop: {{ section.settings.columns_gap_vertical }}px {{ section.settings.columns_gap_horizontal }}px;
  }

  @media screen and (min-width: 750px) {
    .ymm-results--{{ section.id }} .product-grid {
      --product-grid-columns-desktop: repeat(auto-fill, minmax({{ product_card_size }}, 1fr));
    }
  }
{% endstyle %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    {% if section.settings.product_grid_width == 'centered' %}section--page-width{% else %}section--full-width{% endif %}
    color-{{ section.settings.color_scheme }}
    ymm-results ymm-results--{{ section.id }}
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- liquid
    # Universal accessories fit every vehicle, so they carry no year or body
    # metafield — which means Shopify's filters exclude them from
    # collection.products. They are pulled from their own collection and merged
    # into whichever product type they belong to, after the exact matches.
    if universal_collection != blank
      assign universal_products = universal_collection.products
    else
      assign universal_products = '' | split: ','
    endif

    assign vehicle_ids = collection.products | map: 'id'

    # Union of both sides, so a type only universal products use still gets a
    # group, and the collection's own sort order drives the group order.
    assign vehicle_types = collection.products | map: 'type'
    assign universal_types = universal_products | map: 'type'
    assign product_types = vehicle_types | concat: universal_types | uniq

    # A universal product may also sit in the vehicle collection and survive the
    # filter. Count it once, and render it once, as the vehicle-specific match.
    assign universal_extra = 0
    for product in universal_products
      unless vehicle_ids contains product.id
        assign universal_extra = universal_extra | plus: 1
      endunless
    endfor
    assign total_count = collection.products.size | plus: universal_extra

    # The status line describes the vehicle from the filters Shopify applied.
    # Liquid cannot read arbitrary query params, but it can read active filters.
    assign vehicle = ''
    for filter in collection.filters
      for value in filter.active_values
        assign vehicle = vehicle | append: value.label | append: ' '
      endfor
    endfor
    assign vehicle = vehicle | strip
  -%}

  <p class="ymm__status">
    {{- total_count }}
    {% if total_count == 1 %}product{% else %}products{% endif %}
    {%- if vehicle != blank %} for {{ vehicle }}{% endif -%}
  </p>

  {%- if total_count == 0 -%}
    <div class="ymm__message">
      <h2 class="h4 ymm__message-title">
        {{- section.settings.empty_heading | default: 'No products found' -}}
      </h2>
      <p class="ymm__message-text">
        {{- section.settings.empty_text | default: "We couldn't find parts matching this vehicle." -}}
      </p>
      {%- if section.settings.change_vehicle_url != blank -%}
        <a class="button" href="{{ section.settings.change_vehicle_url }}">Choose your vehicle</a>
      {%- endif -%}
    </div>
  {%- else -%}
    {%- assign tabs_html = '' -%}

    {%- comment -%}
      Groups are captured rather than emitted directly so the tab strip can be
      rendered above them. `assign` still executes inside a capture — only the
      output is diverted — so the tabs accumulate during the same pass that
      counts the products, instead of counting everything a second time.
    {%- endcomment -%}
    {%- capture groups_html -%}
      {%- for product_type in product_types -%}
        {%- liquid
          # Compared explicitly rather than with the `where` filter, because a
          # product with no product type has type == '' and `where` treats a blank
          # value as a truthiness test — those products would be counted in the
          # total but never rendered in a group.
          assign group_count = 0

          for product in collection.products
            if product.type == product_type
              assign group_count = group_count | plus: 1
            endif
          endfor

          for product in universal_products
            if product.type == product_type
              unless vehicle_ids contains product.id
                assign group_count = group_count | plus: 1
              endunless
            endif
          endfor

          assign type_label = product_type | default: 'Other'
          assign type_anchor = type_label | handleize | prepend: 'ymm-'
        -%}

        {%- if group_count > 0 -%}
          {%- capture tab -%}
            <a class="ymm__tab" href="#{{ type_anchor }}" data-tab="{{ type_anchor }}">
              {{- type_label -}}
              {%- if show_count %}<span class="ymm__tab-count">{{ group_count }}</span>{% endif -%}
            </a>
          {%- endcapture -%}
          {%- assign tabs_html = tabs_html | append: tab -%}

          <div class="ymm__category" id="{{ type_anchor }}">
            <h2 class="{{ heading_class }} ymm__category-heading">
              {{ type_label }}
              {%- if show_count %}
                <span class="ymm__category-count">({{ group_count }})</span>
              {%- endif -%}
            </h2>

            <ul
              class="product-grid product-grid--grid"
              role="list"
              style="--mobile-columns: 2;"
            >
              {%- for product in collection.products -%}
                {%- if product.type == product_type -%}
                  <li class="product-grid__item" data-product-id="{{ product.id }}">
                    {% # theme-check-disable %}
                    {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
                    {% # theme-check-enable %}
                  </li>
                {%- endif -%}
              {%- endfor -%}

              {%- comment -%} Universal trails the exact matches within the group. {%- endcomment -%}
              {%- for product in universal_products -%}
                {%- if product.type == product_type -%}
                  {%- unless vehicle_ids contains product.id -%}
                    <li class="product-grid__item" data-product-id="{{ product.id }}">
                      {%- comment -%}
                        Same static block id as the vehicle-specific loop above,
                        so both share one "Product card" entry in the theme
                        editor. A second id would render a second, near-identical
                        config that only ever styled universal accessories.
                      {%- endcomment -%}
                      {% # theme-check-disable %}
                      {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
                      {% # theme-check-enable %}
                      {%- comment -%}
                        Carries the theme's own badge classes so that once the
                        script moves it into the card's .product-badges stack it
                        picks up the radius, font and padding configured on the
                        product image block. Rendered here rather than hidden,
                        so it still reads as a badge if the move never happens.
                      {%- endcomment -%}
                      <span
                        class="product-badges__badge product-badges__badge--rectangle ymm__universal-badge"
                        data-universal-badge
                      >
                        {{- section.settings.universal_badge_label | default: 'Universal' -}}
                      </span>
                    </li>
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if section.settings.show_tabs and tabs_html != blank -%}
      <nav class="ymm__tabs" data-role="tabs" aria-label="Product categories">
        {{ tabs_html }}
      </nav>
    {%- endif -%}

    {{ groups_html }}
  {%- endif -%}
</div>

{% stylesheet %}
  .ymm-results .ymm__status {
    margin: 0 0 var(--padding-sm);
    font-size: var(--font-paragraph--size);
    color: var(--color-foreground-muted);
  }

  .ymm-results .ymm__message {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--padding-sm);
    text-align: center;
    padding-block: var(--padding-3xl);
    padding-inline: var(--padding-sm);
  }

  .ymm-results .ymm__message-title {
    margin: 0;
  }

  .ymm-results .ymm__message-text {
    margin: 0;
    max-inline-size: 40ch;
    color: var(--color-foreground-muted);
  }

  .ymm-results .ymm__tabs {
    position: sticky;
    top: var(--header-height, 0px);
    z-index: 2;
    display: flex;
    gap: var(--padding-sm);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    margin-block-end: var(--padding-lg);
    background-color: var(--color-background);
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .ymm-results .ymm__tabs::-webkit-scrollbar {
    display: none;
  }

  .ymm-results .ymm__tab {
    flex: none;
    padding-block: var(--padding-xs);
    white-space: nowrap;
    text-decoration: none;
    font-size: var(--font-paragraph--size);
    color: var(--color-foreground-muted);
    border-block-end: 2px solid transparent;
    transition: color var(--animation-speed) var(--animation-easing),
      border-color var(--animation-speed) var(--animation-easing);
  }

  .ymm-results .ymm__tab:hover {
    color: var(--color-foreground);
  }

  .ymm-results .ymm__tab[aria-current='true'] {
    color: var(--color-foreground);
    font-weight: 600;
    border-block-end-color: currentcolor;
  }

  .ymm-results .ymm__tab-count {
    margin-inline-start: var(--padding-3xs);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
    font-weight: 400;
  }

  .ymm-results .ymm__category {
    margin-block-end: var(--padding-3xl);
    /* Clears the sticky header and tab strip when jumped to via an anchor. */
    scroll-margin-top: calc(var(--header-height, 0px) + var(--ymm-tabs-height, 0px) + var(--padding-sm));
  }

  .ymm-results .ymm__category-heading {
    display: flex;
    align-items: baseline;
    gap: var(--padding-2xs);
    margin-block: 0 var(--padding-sm);
    padding-block-end: var(--padding-2xs);
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .ymm-results .ymm__category-count {
    font-size: var(--font-paragraph--size);
    font-weight: 400;
    font-family: var(--font-paragraph--family);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
  }

  /* Sits under the sale / sold-out badge once moved into .product-badges.
     width is constrained because .product-badges__badge is display:flex, which
     would otherwise stretch the badge across the card in the pre-move state. */
  .ymm-results .ymm__universal-badge {
    width: fit-content;
    margin-block-start: var(--padding-3xs);
  }
{% endstylesheet %}

{%- comment -%}
  Presentation only. The tabs are rendered server-side and work as plain anchor
  links with no JS — this just adds the selected state and keeps the sticky
  strip from covering the heading it jumps to.
{%- endcomment -%}
<script>
  (function () {
    var root = document.querySelector('.ymm-results--{{ section.id }}');
    if (!root) return;

    /**
     * The theme renders its sale / sold-out badge into an absolutely positioned
     * .product-badges stack inside the card image, and stacks its children as
     * plain blocks. Moving ours in there is what puts it on the image, directly
     * beneath the sale badge, with no coordinates of our own to keep in sync.
     *
     * Runs before the tabs guard below, which returns early when tabs are off.
     */
    Array.prototype.slice.call(root.querySelectorAll('[data-universal-badge]')).forEach(function (badge) {
      var card = badge.closest('.product-grid__item');
      var stack = card && card.querySelector('.product-badges');
      if (stack) stack.appendChild(badge);
    });

    var tabsEl = root.querySelector('[data-role="tabs"]');
    if (!tabsEl) return;

    var tabs = Array.prototype.slice.call(tabsEl.querySelectorAll('.ymm__tab'));
    var groups = tabs
      .map(function (tab) {
        return document.getElementById(tab.dataset.tab);
      })
      .filter(Boolean);
    if (!groups.length) return;

    /**
     * The strip is sticky, so it covers whatever scrolls under it. Publishing
     * its height lets scroll-margin-top clear it on an anchor jump, and gives
     * the spy the same threshold the browser scrolls to.
     */
    function publishHeight() {
      root.style.setProperty('--ymm-tabs-height', tabsEl.offsetHeight + 'px');
    }

    /**
     * Where an anchor jump actually parks this group: its own scroll-margin-top,
     * which already accounts for the sticky header and tab strip.
     *
     * Read from the computed style rather than recalculated, so the spy and the
     * browser can never disagree. They did: the spy used a hardcoded 4px slack
     * where the CSS uses --padding-sm, leaving a clicked group a few pixels
     * below the threshold and the tab above it highlighted instead.
     */
    function restingOffset(group) {
      return parseFloat(getComputedStyle(group).scrollMarginTop) || 0;
    }

    function setActive(id) {
      tabs.forEach(function (tab) {
        if (tab.dataset.tab === id) tab.setAttribute('aria-current', 'true');
        else tab.removeAttribute('aria-current');
      });
    }

    /** The last group that has reached its resting position wins. */
    function sync() {
      var active = groups[0];

      groups.forEach(function (group) {
        // 2px of slack absorbs the sub-pixel rounding a smooth scroll can leave
        // behind, which would otherwise miss the group by a fraction.
        if (group.getBoundingClientRect().top <= restingOffset(group) + 2) active = group;
      });

      // A short last group may never reach the threshold, which would leave the
      // spy stuck on the second to last tab at the bottom of the page.
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        active = groups[groups.length - 1];
      }

      setActive(active.id);
    }

    var ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(function () {
        sync();
        ticking = false;
      });
    }

    tabs.forEach(function (tab) {
      // Reflect the click straight away — smooth scrolling would otherwise
      // leave the previous tab highlighted for the whole animation.
      tab.addEventListener('click', function () {
        setActive(tab.dataset.tab);
      });
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener(
      'resize',
      function () {
        publishHeight();
        onScroll();
      },
      { passive: true }
    );

    publishHeight();
    sync();
  })();
</script>

{% schema %}
{
  "name": "YMM Fitment Results",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Body and year are applied with Shopify's storefront filters. Both metafields must be enabled as filters in the Search & Discovery app, or the URL params are ignored."
    },
    {
      "type": "collection",
      "id": "universal_collection",
      "label": "Universal accessories collection",
      "info": "Merged into each product type group, after the vehicle-specific matches. These products carry no year or body metafield, so Shopify's filters would otherwise exclude them."
    },
    {
      "type": "url",
      "id": "change_vehicle_url",
      "label": "Change vehicle link"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty state heading",
      "default": "No products found"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "We couldn't find parts matching this vehicle."
    },
    {
      "type": "text",
      "id": "universal_badge_label",
      "label": "Universal badge label",
      "default": "Universal"
    },
    {
      "type": "header",
      "content": "Groups"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Group heading size",
      "info": "Visual size only — the heading stays an h2 for accessibility.",
      "options": [
        { "value": "h2", "label": "Extra large" },
        { "value": "h3", "label": "Large" },
        { "value": "h4", "label": "Medium" },
        { "value": "h5", "label": "Small" },
        { "value": "h6", "label": "Extra small" }
      ],
      "default": "h5"
    },
    {
      "type": "checkbox",
      "id": "show_group_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show category tabs",
      "info": "A sticky row of links that jump to each group and highlight the one in view.",
      "default": true
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "Card size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "Width",
      "options": [
        { "value": "centered", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "centered"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "Horizontal gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "Vertical gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [{ "name": "YMM Fitment Results" }]
}
{% endschema %}
