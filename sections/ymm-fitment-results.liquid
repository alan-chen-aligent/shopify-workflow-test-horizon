{% comment %}
  YMM Fitment Results — sections/ymm-fitment-results.liquid

  Renders on a vehicle collection page. The collection handle has already
  scoped the page to one make and model; the ?body= / ?year= / ?series= params
  written by the vehicle selector (sections/vehicle-search.liquid) narrow it
  further against each product's custom.fitment_groups metafield. Results are
  grouped by product type.

  When no product in the collection carries fitment_groups, the narrowing is
  skipped and the whole collection is listed — the collection alone is already
  a correct answer for the vehicle, so an empty page would be strictly worse.

  Products are rendered server-side, as the theme's own product card
  (blocks/_product-card.liquid), into a hidden pool. The script then filters the
  pool by the resolved fitment group and moves the cards into one Horizon
  product grid per category. Rendering in Liquid is the whole point: the cards
  get quick add, swatches, price formatting and view transitions from the theme
  for free, instead of a second card implementation drifting in JS.
{% endcomment %}

{% liquid
  # A "collection" setting resolves to the collection object itself.
  assign universal_collection = section.settings.universal_collection
  assign product_limit = section.settings.product_limit
%}

{% capture product_card_size %}
  {% render 'util-product-grid-card-size', section: section %}
{% endcapture %}
{% assign product_card_size = product_card_size | strip %}

{% style %}
  .ymm-results--{{ section.id }} {
    --ymm-sidebar-width: 22rem;
    --product-grid-gap-mobile: {{ section.settings.columns_gap_vertical | at_most: 12 }}px {{ section.settings.columns_gap_horizontal | at_most: 12 }}px;
    --product-grid-gap-desktop: {{ section.settings.columns_gap_vertical }}px {{ section.settings.columns_gap_horizontal }}px;
  }

  @media screen and (min-width: 750px) {
    .ymm-results--{{ section.id }} .product-grid {
      --product-grid-columns-desktop: repeat(auto-fill, minmax({{ product_card_size }}, 1fr));
    }
  }
{% endstyle %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    {% if section.settings.product_grid_width == 'centered' %}section--page-width{% else %}section--full-width{% endif %}
    color-{{ section.settings.color_scheme }}
    ymm-results ymm-results--{{ section.id }}
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <p class="ymm__status" data-role="status"></p>
  <div data-role="results"></div>

{%- comment -%}
  Card pool. Every candidate product for this collection is rendered once,
  hidden, carrying the attributes the script filters and sorts on. The script
  moves these <li> nodes into the per-category grids — it never re-creates
  them, so a card in the grid is byte-for-byte the theme's product card.
{%- endcomment -%}
<ul class="ymm__pool" data-role="pool" hidden>
  {%- for product in collection.products limit: product_limit -%}
    {%- liquid
      assign fitment_attr = ''
      assign fitment_groups = product.metafields.custom.fitment_groups.value

      if fitment_groups != blank
        # Delimited on both ends so an indexOf('|key|') match cannot straddle
        # two group keys or hit a prefix of a longer one.
        assign fitment_attr = fitment_groups | join: '|'
        assign fitment_attr = '|' | append: fitment_attr | append: '|'
      endif
    -%}
    <li
      class="product-grid__item"
      data-product-id="{{ product.id }}"
      data-type="{{ product.type | default: 'Other' | escape }}"
      data-title="{{ product.title | escape }}"
      data-price="{{ product.price }}"
      data-fitment-groups="{{ fitment_attr | escape }}"
    >
      {% # theme-check-disable %}
      {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
      {% # theme-check-enable %}
    </li>
  {%- endfor -%}

  {%- for product in universal_collection.products limit: product_limit -%}
    <li
      class="product-grid__item"
      data-product-id="{{ product.id }}"
      data-type="{{ product.type | default: 'Other' | escape }}"
      data-title="{{ product.title | escape }}"
      data-price="{{ product.price }}"
      data-universal="true"
    >
      {% # theme-check-disable %}
      {% content_for 'block', type: '_product-card', id: 'universal-card', closest.product: product %}
      {% # theme-check-enable %}
      <span class="ymm__universal-badge">Universal</span>
    </li>
  {%- endfor -%}
</ul>
</div>

{% stylesheet %}
  .ymm-results .ymm__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--padding-sm);
    flex-wrap: wrap;
    padding-block: var(--padding-sm);
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  /* These blocks all set an explicit display, which outranks the UA rule for
     [hidden]. Each one that the script toggles needs its own opt-out. */
  .ymm-results .ymm__toolbar[hidden] {
    display: none;
  }

  .ymm-results .ymm__status {
    margin: 0;
    font-size: var(--font-paragraph--size);
    color: var(--color-foreground-muted);
  }

  .ymm-results .ymm__toolbar-actions {
    display: flex;
    align-items: center;
    gap: var(--padding-sm);
  }

  .ymm-results .ymm__change {
    font-size: var(--font-paragraph--size);
    color: var(--color-foreground-muted);
    text-decoration: none;
  }

  .ymm-results .ymm__change:hover {
    color: var(--color-foreground);
    text-decoration: underline;
  }

  .ymm-results .ymm__sort-label {
    font-size: var(--font-paragraph--size);
    color: var(--color-foreground-muted);
  }

  .ymm-results .ymm__sort-select {
    padding: var(--padding-2xs) var(--padding-xs);
    border: 1px solid var(--color-input-border, rgb(var(--color-foreground-rgb) / var(--opacity-15)));
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-background);
    color: var(--color-foreground);
    cursor: pointer;
  }

  .ymm-results .ymm__layout {
    display: flex;
    align-items: flex-start;
    gap: var(--padding-xl);
    padding-block-start: var(--padding-lg);
  }

  .ymm-results .ymm__sidebar {
    inline-size: var(--ymm-sidebar-width);
    flex-shrink: 0;
    position: sticky;
    top: calc(var(--header-height, 6rem) + var(--padding-sm));
    align-self: flex-start;
  }

  .ymm-results .ymm__sidebar[hidden] {
    display: none;
  }

  .ymm-results .ymm__sidebar-nav {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
  }

  .ymm-results .ymm__sidebar-heading {
    margin: 0;
    padding: var(--padding-sm) var(--padding-sm) var(--padding-2xs);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .ymm-results .ymm__sidebar-list {
    list-style: none;
    margin: 0;
    padding-block: var(--padding-3xs);
    padding-inline: 0;
  }

  .ymm-results .ymm__sidebar-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--padding-xs);
    padding: var(--padding-xs) var(--padding-sm);
    font-size: var(--font-paragraph--size);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
    text-decoration: none;
    border-inline-start: 3px solid transparent;
    transition: color var(--animation-speed) var(--animation-easing),
      background-color var(--animation-speed) var(--animation-easing),
      border-color var(--animation-speed) var(--animation-easing);
  }

  .ymm-results .ymm__sidebar-list a:hover {
    color: var(--color-foreground);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    border-inline-start-color: rgb(var(--color-foreground-rgb) / var(--opacity-25));
  }

  .ymm-results .ymm__sidebar-list a[aria-current='true'] {
    color: var(--color-foreground);
    font-weight: 600;
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
    border-inline-start-color: var(--color-foreground);
  }

  .ymm-results .ymm__sidebar-count {
    font-size: 0.75rem;
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
  }

  .ymm-results .ymm__main {
    flex: 1;
    min-inline-size: 0;
  }

  .ymm-results .ymm__message {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--padding-sm);
    text-align: center;
    padding-block: var(--padding-3xl);
    padding-inline: var(--padding-sm);
  }

  .ymm-results .ymm__message[hidden] {
    display: none;
  }

  .ymm-results .ymm__message-title {
    margin: 0;
  }

  .ymm-results .ymm__message-text {
    margin: 0;
    max-inline-size: 40ch;
    color: var(--color-foreground-muted);
  }

  .ymm-results .ymm__error {
    padding: var(--padding-sm);
    margin-block-end: var(--padding-sm);
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: var(--style-border-radius-inputs);
    color: var(--color-foreground);
  }

  .ymm-results .ymm__error[hidden] {
    display: none;
  }

  .ymm-results .ymm__loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--padding-xs);
    padding-block: var(--padding-3xl);
    color: var(--color-foreground-muted);
  }

  .ymm-results .ymm__spinner {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    flex-shrink: 0;
    border: 2px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-top-color: var(--color-foreground);
    border-radius: 50%;
    animation: ymm-spin 0.7s linear infinite;
  }

  @keyframes ymm-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .ymm-results .ymm__category {
    margin-block-end: var(--padding-3xl);
    scroll-margin-top: calc(var(--header-height, 6rem) + var(--padding-sm));
  }

  .ymm-results .ymm__category-heading {
    display: flex;
    align-items: baseline;
    gap: var(--padding-2xs);
    margin-block: 0 var(--padding-sm);
    padding-block-end: var(--padding-2xs);
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .ymm-results .ymm__category-count {
    font-size: var(--font-paragraph--size);
    font-weight: 400;
    font-family: var(--font-paragraph--family);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
  }

  /* The pool only ever holds cards that are not currently on screen. */
  .ymm-results .ymm__pool[hidden] {
    display: none;
  }

  .ymm-results .ymm__universal-badge {
    display: inline-block;
    margin-block-start: var(--padding-3xs);
    padding: 2px 8px;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15));
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }

  @media screen and (max-width: 989px) {
    .ymm-results .ymm__sidebar {
      display: none !important;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.querySelector('.ymm-results--{{ section.id }}');
    if (!root) return;

    var cats = window.CATEGORY_ORDER || [];
    var statusEl = root.querySelector('[data-role="status"]');
    var resultsEl = root.querySelector('[data-role="results"]');
    var poolEl = root.querySelector('[data-role="pool"]');

    // Every card rendered by Liquid, in server order. Captured once, because
    // the nodes get moved out of the pool and into the category grids.
    var allItems = Array.prototype.slice.call(poolEl.children);

    var params = new URLSearchParams(window.location.search);
    var qBody = (params.get('body') || '').trim();
    var qYear = (params.get('year') || '').trim();
    var qSeries = (params.get('series') || '').trim();

    function anchorFor(category) {
      return 'ymm-cat-' + category.replace(/[^a-zA-Z0-9]/g, '');
    }

    /**
     * Narrowing by body/year is only applied when the products actually carry
     * fitment data. The collection handle has already scoped this page to one
     * make and model, so with no fitment metafield the whole collection is the
     * correct answer — showing nothing would be worse than showing everything.
     */
    function hasFitmentData() {
      return allItems.some(function (item) {
        return (item.dataset.fitmentGroups || '') !== '';
      });
    }

    /**
     * A product fits when one of its fitment group keys matches the requested
     * vehicle. Keys are stored '|a|b|c|' delimited, so a substring test cannot
     * straddle two keys or match a prefix of a longer one.
     */
    function fitsVehicle(item) {
      if (item.dataset.universal === 'true') return true;

      var groups = item.dataset.fitmentGroups || '';
      if (groups === '') return false;

      return keyCandidates().some(function (key) {
        return groups.indexOf('|' + key + '|') !== -1;
      });
    }

    /**
     * The fitment group key format is owned by the app that writes the
     * metafield, so this builds the combinations the selector's params can
     * describe and accepts any of them.
     */
    function keyCandidates() {
      var keys = [];
      if (qYear && qBody) keys.push(qYear + '_' + qBody);
      if (qYear && qSeries) keys.push(qYear + '_' + qSeries);
      if (qYear) keys.push(qYear);
      if (qSeries) keys.push(qSeries);
      return keys;
    }

    function describeVehicle() {
      var parts = [];
      if (qYear) parts.push(qYear);
      if (qBody) parts.push(qBody);
      if (qSeries) parts.push('(' + qSeries + ')');
      return parts.join(' ');
    }

    /** Categories in CATEGORY_ORDER first, then whatever else turned up. */
    function groupByCategory(items) {
      var map = {};
      var order = [];

      items.forEach(function (item) {
        var category = item.dataset.type || 'Other';
        if (!map[category]) {
          map[category] = [];
          order.push(category);
        }
        map[category].push(item);
      });

      var groups = [];
      cats.forEach(function (category) {
        if (map[category]) groups.push({ name: category, items: map[category] });
      });
      order.forEach(function (category) {
        if (cats.indexOf(category) === -1) groups.push({ name: category, items: map[category] });
      });
      return groups;
    }

    /** Builds one Horizon product grid per category and moves the cards in. */
    function buildGrid(group) {
      var section = document.createElement('div');
      section.className = 'ymm__category';
      section.id = anchorFor(group.name);

      var heading = document.createElement('h2');
      heading.className = 'h5 ymm__category-heading';
      heading.appendChild(document.createTextNode(group.name));

      var count = document.createElement('span');
      count.className = 'ymm__category-count';
      count.textContent = '(' + group.items.length + ')';
      heading.appendChild(count);

      var grid = document.createElement('ul');
      grid.className = 'product-grid product-grid--grid';
      grid.setAttribute('role', 'list');
      grid.style.setProperty('--mobile-columns', '2');

      group.items.forEach(function (item) {
        grid.appendChild(item);
      });

      section.appendChild(heading);
      section.appendChild(grid);
      return section;
    }

    function render() {
      var narrowing = hasFitmentData() && keyCandidates().length > 0;
      var matching = narrowing ? allItems.filter(fitsVehicle) : allItems.slice();

      // The universal collection can overlap the vehicle collection. First
      // occurrence wins, which is the vehicle-specific one.
      var seen = {};
      matching = matching.filter(function (item) {
        var id = item.dataset.productId;
        if (seen[id]) return false;
        seen[id] = true;
        return true;
      });

      var vehicle = describeVehicle();
      statusEl.textContent =
        matching.length + (matching.length === 1 ? ' product' : ' products') + (vehicle ? ' for ' + vehicle : '');

      resultsEl.textContent = '';

      if (matching.length === 0) {
        var none = document.createElement('p');
        none.className = 'ymm__message-text';
        none.textContent = "We couldn't find products for this vehicle.";
        resultsEl.appendChild(none);
        return;
      }

      groupByCategory(matching).forEach(function (group) {
        resultsEl.appendChild(buildGrid(group));
      });
    }

    render();
  })();
</script>

{% schema %}
{
  "name": "YMM Fitment Results",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "universal_collection",
      "label": "Universal accessories collection",
      "info": "Every product in this collection is shown for every vehicle."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products rendered per collection",
      "min": 20,
      "max": 100,
      "step": 10,
      "default": 50,
      "info": "Cards are rendered up front and filtered in the browser. Higher values cover more fitments but make the page heavier."
    },
    {
      "type": "url",
      "id": "change_vehicle_url",
      "label": "Change vehicle link"
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty state heading",
      "default": "Select your vehicle"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Use the vehicle selector on the home page to find parts compatible with your vehicle."
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "Card size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "Width",
      "options": [
        { "value": "centered", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "centered"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "Horizontal gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "Vertical gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [{ "name": "YMM Fitment Results" }]
}
{% endschema %}
