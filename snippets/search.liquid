{%- doc -%}
  Renders the header search.

  This is the vehicle search, not Shopify's product search: the icon button that
  used to open the predictive-search modal is gone, and the header now carries
  the free-text vehicle input inline. Picking a suggestion goes straight to that
  vehicle's collection. See snippets/vehicle-quick-search.liquid.

  The header renders this up to twice — once for the desktop menu layout and
  once for the mobile drawer layout — and shows one at a time through the
  --hidden-on-drawer / --hidden-on-menu classes. Both copies are live inputs, so
  each needs its own `id`.

  @param {string} [style] - 'none' renders nothing. Comes from the header's
    "Show search" setting.
  @param {string} [class] - Additional classes for the wrapper.
  @param {string} [id] - Unique suffix for element ids. Required whenever the
    page renders more than one copy.

  The old icon button also took `display_style`, to render as an icon or as the
  word "Search". An input is neither, so the header no longer passes it.

  @example
  {% render 'search', style: 'inline', id: 'header' %}
{%- enddoc -%}

{%- assign search_id = id | default: 'header' -%}

{% unless style == 'none' %}
  <div
    class="search-action search-action--vehicle{% if class != blank %} {{ class | strip }}{% endif %}"
  >
    {% render 'vehicle-quick-search', id: search_id %}
  </div>
{% endunless %}

{% stylesheet %}
  .search-action {
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: flex;
  }

  /* An input, unlike the icon button this replaced, wants the room it can get —
     but not the whole column, or the logo and the menu lose theirs. */
  .search-action--vehicle {
    flex: 1 1 auto;
    min-width: 10rem;
    max-width: 24rem;
  }

  /* The panel has a minimum width of its own, so a narrow input in the right
     column would push it off the edge of the page. Anchor it to the right
     there and it grows inwards instead. */
  .header__column--right .search-action--vehicle .vqs__panel {
    left: auto;
    right: 0;
  }

  @media screen and (max-width: 749px) {
    .search-action--hidden-on-drawer {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }
  }

  /* On mobile the header columns collapse into a five-slot grid of 44px
     bookends around the logo — a slot sized for the old icon. The input takes a
     row of its own underneath instead, where it has the width to be typed into.
     Specificity beats .header__columns .search-action from sections/header.liquid
     regardless of which stylesheet the theme concatenates first. */
  @media screen and (max-width: 749px) {
    .header__columns .search-action--vehicle.search-action {
      grid-area: auto;
      grid-column: 1 / -1;
      grid-row: 2;
      max-width: none;
      margin-block-start: var(--margin-xs);
    }
  }
{% endstylesheet %}
